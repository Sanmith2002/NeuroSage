# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local environment
.env*

# deployment and generated files
.vercel
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/
*.tsbuildinfo

# pd_copathology: PPMI research data - never commit
components/pd_copathology/data/raw/**
components/pd_copathology/data/interim/**
components/pd_copathology/data/processed/**
components/pd_copathology/data/splits/**
!components/pd_copathology/data/raw/.gitkeep
!components/pd_copathology/data/interim/.gitkeep
!components/pd_copathology/data/processed/.gitkeep
!components/pd_copathology/data/splits/.gitkeep

# pd_copathology: aggregate PPMI-derived reports stay local until the supervisor confirms what may be shared
# (the folder structure stays tracked through .gitkeep files)
components/pd_copathology/reports/**
!components/pd_copathology/reports/**/
!components/pd_copathology/reports/**/.gitkeep

# pd_copathology: out-of-fold predictions are participant level
components/pd_copathology/data/processed/oof/

# pd_copathology: human final-evaluation approval and lock files are never committed
components/pd_copathology/configs/frozen/final_approval.yaml
components/pd_copathology/configs/frozen/*.lock
components/pd_copathology/configs/frozen/final_evaluation_lock.json

# pd_copathology: the Lumipulse threshold is derived from real participant data; it stays local
components/pd_copathology/configs/frozen/lumipulse_gmm_v*.json

# pd_copathology: trained-model binaries - never commit
components/pd_copathology/models/final/**
!components/pd_copathology/models/final/.gitkeep

# pd_copathology: env template is safe to commit (.env itself stays ignored by .env* above)
!components/pd_copathology/.env.example

# pd_copathology: synthetic test download, regenerated by tests/fixtures/build_fixtures.py
components/pd_copathology/tests/fixtures/synthetic_ppmi/

# pd_copathology: local experiment/runtime artifacts
components/pd_copathology/mlruns/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ipynb_checkpoints/
